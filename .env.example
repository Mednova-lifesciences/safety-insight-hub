# Base URL of the FastAPI service that wraps the pv_assist Python package.
# Leave unset to run the UI without a backend (pending-integration / demo states).
VITE_PV_API_BASE_URL=http://localhost:8000

# Server-side only — never exposed to the browser. Powers the AI-assisted
# line-list analysis/fix, PSUR/PBRER review/fix, and ICSR image extraction
# workflows. Without it, those workflows fall back to deterministic
# rule-based behaviour instead of failing.
OPENAI_API_KEY=
